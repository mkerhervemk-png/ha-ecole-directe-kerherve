{
  "title": "Ecole Directe",
  "config": {
    "flow_title": "Ecole Directe configuration",
    "step": {
      "user": {
        "title": "Vos informations de connexion",
        "description": "Donnez vos informations de connexion à Ecole Directe",
        "data": {
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]",
          "qcm_filename": "[%key:common::config_flow::data::qcm_filename%]",
          "allow_notification": "[%key:common::config_flow::data::allow_notification%]"
        },
        "data_description": {
          "username": "user name",
          "password": "Password",
          "qcm_filename": "File name of qcm",
          "allow_notification": "Allow notifications"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "double_auth": "[%key:common::config_flow::error::double_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "description": "Customize the way the integration works",
        "data": {
          "refresh_interval": "Data refresh interval (in minutes)",
          "lunch_break_time": "Lunch break time",
          "decode_html": "Decode HTML for homeworks - Warning it will delete all HTML (style, links, iFrame, etc.)",
          "notes_affichees": "Maximum grades to display"
        }
      }
    }
  },
  "entity_component": {
    "_": {
      "state_attributes": {
        "fan_mode": {
          "state": {
            "1": "Maîtrise insuffisante",
            "2": "Maîtrise fragile",
            "3": "Maîtrise satisfaisante",
            "4": "Très bonne maîtrise"
          }
        }
      }
    }
  },
  "exceptions": {
    "authentication_failed": {
      "message": "École Directe rejected the username or password."
    },
    "update_failed": {
      "message": "Unable to fetch data from École Directe."
    },
    "no_loaded_entry": {
      "message": "No École Directe account is loaded."
    }
  },
  "services": {
    "devoir_effectue": {
      "name": "Mark homework as done",
      "description": "Ticks or unticks a homework item on École Directe.",
      "fields": {
        "eleve_id": {
          "name": "Pupil ID",
          "description": "École Directe ID of the pupil."
        },
        "devoir_id": {
          "name": "Homework ID",
          "description": "ID of the homework (attribute of the homework sensors)."
        },
        "effectue": {
          "name": "Done",
          "description": "On = done, off = to do."
        }
      }
    },
    "reload_data": {
      "name": "Refresh data",
      "description": "Polls École Directe right now for every account."
    }
  }
}
